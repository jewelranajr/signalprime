# CryptoAI Pro — Master Signal Engine configuration
# Copy to .env and adjust. No exchange API keys are needed: the engine uses
# Binance PUBLIC market-data endpoints only. Never put secrets in this file.

# --- API server ---
PORT=8080
HOST=0.0.0.0
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# --- Master signal filter (spec section 21) ---
MIN_SCORE=85
MIN_CONFIDENCE=80
MIN_DIRECTION_GAP=10
MIN_RR=2.0

# --- A+ tier thresholds ---
A_PLUS_SCORE=92
A_PLUS_CONFIDENCE=88
A_PLUS_RR=2.5

# --- Risk ---
ACCOUNT_BALANCE=10000
RISK_PERCENT=1
MAX_LEVERAGE=10
BASE_LEVERAGE=3

# --- Data / signal lifecycle ---
MIN_CANDLES=220
SIGNAL_TTL_MS=3600000
COOLDOWN_MS=900000
SAME_DIRECTION_COOLDOWN_MS=1800000
REGIME_COOLDOWN_MS=3600000

# --- Liquidity filter ---
MAX_SPREAD_PCT=0.15
MIN_QUOTE_VOLUME_24H=1000000

# --- Binance market data ---
BINANCE_BASE_URLS=https://api.binance.com,https://data-api.binance.vision
REQUEST_TIMEOUT_MS=12000
MAX_RETRIES=3
CACHE_TTL_MS=15000
MAX_CONCURRENCY=8

# --- Paper trading ---
PAPER_ENABLED=true
PAPER_START_BALANCE=10000
PAPER_FEE_PCT=0.05
PAPER_SLIPPAGE_PCT=0.02
PAPER_FUNDING_PCT_8H=0.01
